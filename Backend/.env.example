# ─── Core (required) ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/multistore

JWT_ACCESS_SECRET=<generate: openssl rand -hex 48>
JWT_REFRESH_SECRET=<generate: openssl rand -hex 48>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── App ──────────────────────────────────────────────────────────────
APP_NAME=UK Marketplace
APP_URL=http://localhost:5173
CLIENT_ORIGIN=*
REFRESH_COOKIE_NAME=refreshToken
PLATFORM_CURRENCY=gbp

# ─── Notifications ────────────────────────────────────────────────────
# Left disabled locally: no SMTP/Twilio creds, so sends would just error.
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_DEBUG=true

# ─── SMTP (optional — fill in to enable email) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=UK Marketplace

# ─── Twilio (optional — SMS / WhatsApp) ───────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ─── Stripe (optional — checkout stays unusable until filled) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success
STRIPE_CANCEL_URL=http://localhost:5173/checkout/cancel

# ─── AWS S3 (optional — image uploads fall back / fail without these) ─
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
AWS_BUCKET_NAME=

# ─── Google (optional) ────────────────────────────────────────────────
# Comma-separated OAuth client IDs (web first; add Android/iOS IDs if used)
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
